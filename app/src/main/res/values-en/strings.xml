    <string name="engines_title">Two disable engines</string>
    <string name="engine_ifw_title">IFW (Intent Firewall, undetectable)</string>
    <string name="engine_ifw_short">IFW</string>
    <string name="engine_ifw_body1">Writes block rules to /data/system/ifw/, intercepting component start requests at the system framework level.</string>
    <string name="engine_ifw_body2">The app cannot detect it or self-recover; rules live outside the APK and survive app updates. Recommended for daily use.</string>
    <string name="engine_pm_title">pm disable (component disabled, survives updates)</string>
    <string name="engine_pm_short">pm disable</string>
    <string name="engine_pm_body1">Marks components as system-level “disabled”. Good compatibility and inspectable, but the app can detect it and may self-recover;</string>
    <string name="engine_pm_body2">the disabled state also survives app updates. Useful for debugging IFW compatibility issues.</string>
    <string name="engines_note">Both engines only touch third-party app components and back up automatically; recovery lives in the list recovery menu.</string>
    <string name="auto_title">Auto re-apply</string>
    <string name="auto_summary">Re-disable SDK components after app install/update (foreground service + persistent notification)</string>
    <string name="auto_off_note1">Off: the foreground service is stopped. On Android 15+ the system skips install/update broadcasts to background apps,</string>
    <string name="auto_off_note2">so newly installed or updated apps will not be re-applied automatically — rescan and re-apply manually.</string>
